{
  "name": "@arnaud-barre/eslint-config",
  "description": "TS-React focused ESLint flat configuration",
  "version": "7.1.0",
  "license": "MIT",
  "type": "module",
  "author": "Arnaud Barré (https://github.com/ArnaudBarre)",
  "private": true,
  "scripts": {
    "postinstall": "bun run build",
    "build": "bun build.ts",
    "test": "node plugin/tests/index.ts",
    "lint": "eslint --max-warnings 0",
    "check": "tsc && bun run test && bun prettier-ci && bun run build && bun lint",
    "prettier": "prettier --write '**/*.{js,cjs,ts,json,md}'",
    "prettier-ci": "bun prettier --check",
    "release": "bun run check && cd dist && npm publish"
  },
  "prettier": {
    "quoteProps": "consistent",
    "experimentalOperatorPosition": "start",
    "plugins": [
      "@arnaud-barre/prettier-plugin-sort-imports"
    ]
  },
  "peerDependencies": {
    "eslint": "^10",
    "typescript": "~6.0"
  },
  "dependencies": {
    "confusing-browser-globals": "^1.0.11",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.4.0",
    "typescript-eslint": "^8.58.0"
  },
  "devDependencies": {
    "@arnaud-barre/prettier-plugin-sort-imports": "^0.2.4",
    "@types/bun": "^1.3.9",
    "@typescript-eslint/rule-tester": "^8.58.0",
    "@typescript-eslint/utils": "^8.58.0",
    "prettier": "^3.8.1"
  }
}
